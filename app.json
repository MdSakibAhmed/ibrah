{
  "expo": {
    "name": "ইবরা - Ibrah",
    "slug": "ibrah",
    "scheme": "ibrah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salman.ibrah",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ইবরা অ্যাপে আপনার ব্যক্তিগত উপলব্ধি ও লার্নিং ভয়েস রেকর্ড করার জন্য মাইক্রোফোন পারমিশন প্রয়োজন।"
      }
    },
    "android": {
      "package": "com.salman.ibrah",
      "adaptiveIcon": {
        "backgroundColor": "#0F382E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sqlite",
      "expo-audio",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8564a1b1-2ac2-4542-8952-d60fe29524bf"
      }
    },
    "owner": "sakib554"
  }
}
