# ==========================================
# ইবরা (Ibrah) - Environment Variables Template
# ==========================================

# ১. Google Gemini API Key (https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ২. Supabase Project Configuration (https://supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ৩. গোপন সিঙ্ক কী (মোবাইল ও ওয়েবকে একে অপরের সাথে যুক্ত করার সিক্রেট কী)
EXPO_PUBLIC_SYNC_KEY=your_secret_sync_key_here
